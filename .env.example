# Gemini AI API設定
# Google AI Studioで取得: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# kintone連携設定

# kintoneのサブドメイン（https://xxxxx.cybozu.com の xxxxx の部分）
KINTONE_SUBDOMAIN=acgaozora

# アプリID 184（入院・退院情報）のAPIトークン
KINTONE_API_TOKEN_184=your_api_token_for_app_184

# アプリID 197（入居・退去情報）のAPIトークン
KINTONE_API_TOKEN_197=your_api_token_for_app_197
