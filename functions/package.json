{
  "name": "welfare-assist-pro-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Welfare Assist Pro - Vertex AI integration",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.9.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "google-auth-library": "^9.0.0",
    "googleapis": "^140.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.4.0"
  },
  "private": true
}
