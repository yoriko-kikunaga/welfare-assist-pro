rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Client edits collection
    match /clientEdits/{aozoraId} {
      // Temporarily allow all authenticated users
      // TODO: Restrict to specific domains after testing
      allow read, write: if isAuthenticated();
    }

    // Reconciliations collection (売上・仕入突合の確定データ)
    match /reconciliations/{docId} {
      allow read, write: if isAuthenticated();
    }

    // OCR name mappings collection (OCR名前マッピングの学習データ)
    match /ocrNameMappings/{docId} {
      allow read, write: if isAuthenticated();
    }

    // System settings collection (介護保険レンタルオーバーライドフラグなど)
    match /systemSettings/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Receipt checks collection (レセプトチェック)
    match /receiptChecks/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Old bed inventory collection (旧ベッド管理: 移行用読み取りのみ)
    match /bedInventory/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /bedSets/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Equipment tracking collection (個体管理)
    match /equipments/{equipmentId} {
      allow read, write: if isAuthenticated();
    }

    // Equipment logs collection (個体管理監査ログ: 追記専用)
    match /equipmentLogs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Equipment sets collection (個体管理セット)
    match /equipmentSets/{setId} {
      allow read, write: if isAuthenticated();
    }

    // Insurance rental item matches (介護保険レンタル品目紐づけ学習データ)
    match /insuranceRentalItemMatches/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Sales item matches (販売品目紐づけ学習データ)
    match /salesItemMatches/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Self-pay rental item matches (自費レンタル品目紐づけ学習データ)
    match /selfPayRentalItemMatches/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
